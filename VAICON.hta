<!DOCTYPE html>
<html lang="el">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<title>VAICON</title>
<HTA:APPLICATION
  ID="vaicon"
  APPLICATIONNAME="VAICON"
  ICON="VAICON.ico"
  BORDER="dialog"
  INNERBORDER="no"
  SCROLL="no"
  SCROLLFLAT="yes"
  SINGLEINSTANCE="yes"
  MAXIMIZEBUTTON="no"
  MINIMIZEBUTTON="yes"
  SHOWINTASKBAR="yes"
  CONTEXTMENU="no"
  SELECTION="no"
/>
<style>
  html, body { height: 100%; margin: 0; overflow: hidden; }
  #scaleWrap { transform-origin: top left; position: relative; }
  body {
    font-family: "Segoe UI", Tahoma, sans-serif;
    background: #7a0000;
    background:
      radial-gradient(circle at 22% 18%, rgba(255,138,101,0.38), rgba(255,138,101,0) 46%),
      linear-gradient(135deg, #e53935 0%, #8e0000 55%, #5c0000 100%);
    color: #ffffff;
    text-align: center;
  }
  .wrap { padding: 58px 0 22px; margin: 0 auto; }
  h1 { font-size: 40px; letter-spacing: 6px; margin: 0; font-weight: bold; }
  .sub { color: #ffd6d6; margin: 6px 0 30px; font-size: 14px; }
  .titleWrap { position: relative; display: inline-block; }
  .orbitBox { position: absolute; left: 50%; top: 50%; width: 130px; height: 130px; margin-left: -65px; margin-top: -65px; transform: scaleX(2.7); pointer-events: none; }
  .orbit { position: absolute; left: 0; top: 0; width: 100%; height: 100%; animation: spin 3.4s linear infinite; }
  @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  .tile {
    display: inline-block;
    vertical-align: top;
    width: 210px;
    height: 175px;
    margin: 10px;
    background: #ffffff;
    color: #0f172a;
    border-radius: 16px;
    cursor: pointer;
    border: 3px solid transparent;
  }
  .tile:hover { border-color: #ffffff; }
  .badge {
    width: 66px; height: 66px; line-height: 66px;
    border-radius: 50%;
    margin: 26px auto 12px;
    color: #ffffff; font-size: 30px; font-weight: bold;
  }
  .label { font-size: 18px; font-weight: bold; }
  #bottom { text-align: left; padding-left: 13px; margin-top: 20px; }
  #time { font-size: 42px; font-weight: bold; letter-spacing: 1px; }
  #date { font-size: 16px; margin-left: 14px; color: #ffe3e3; }
  #corner { position: absolute; right: 14px; bottom: 12px; font-size: 12px; color: #ffd0d0; }
</style>
</head>
<body>
  <div id="scaleWrap">
    <div class="wrap" id="inner">
      <div class="titleWrap"><div class="orbitBox"><div class="orbit" id="orbit"></div></div><h1>VAICON</h1></div>
      <div class="sub">Επιλέξτε πρόγραμμα</div>
      <div id="tiles"></div>
      <div id="bottom"><span id="time">--:--</span><span id="date"></span></div>
    </div>
    <div id="corner"><span id="ver"></span></div>
  </div>

<script language="javascript">
  var LAUNCHER_VERSION = 13;
  var UPDATE_URL = 'https://raw.githubusercontent.com/vaiconapp/vaicon-launcher/main/VAICON.hta';

  (function () {
    try {
      var htaPath = null;
      try {
        var m = String(vaicon.commandLine).match(/([A-Za-z]:\\[^"]*\.hta)/i);
        if (m) htaPath = m[1];
      } catch (e) {}
      if (!htaPath) {
        try { htaPath = decodeURI(location.href).replace(/^file:\/{2,3}/i, '').replace(/\//g, '\\'); } catch (e) {}
      }
      if (!htaPath) return;

      var xhr = new ActiveXObject('MSXML2.ServerXMLHTTP.6.0');
      xhr.setTimeouts(2000, 2000, 2000, 3000);
      xhr.open('GET', UPDATE_URL + '?_=' + (new Date().getTime()), false);
      xhr.send();
      if (xhr.status !== 200) return;

      var vm = String(xhr.responseText).match(/LAUNCHER_VERSION\s*=\s*(\d+)/);
      if (!vm || parseInt(vm[1], 10) <= LAUNCHER_VERSION) return;

      var st = new ActiveXObject('ADODB.Stream');
      st.Type = 1; st.Open(); st.Write(xhr.responseBody);
      st.SaveToFile(htaPath, 2); st.Close();

      var sh2 = new ActiveXObject('WScript.Shell');
      var mshta = sh2.ExpandEnvironmentStrings('%WINDIR%') + '\\System32\\mshta.exe';
      sh2.Run('cmd /c timeout /t 1 /nobreak >nul & "' + mshta + '" "' + htaPath + '"', 0, false);
      window.close();
    } catch (e) {}
  })();

  var sh  = new ActiveXObject('WScript.Shell');
  var fso = new ActiveXObject('Scripting.FileSystemObject');

  var PROGRAMS = [
    { key: 'std',  label: 'Τυποποιημένες',       color: '#00695c', letter: 'Τ', url: 'https://vaiconapp.netlify.app' },
    { key: 'eid',  label: 'Ειδικές',             color: '#b71c1c', letter: 'Ε', url: 'https://vaicon-eidikes.netlify.app' },
    { key: 'inst', label: 'Τοποθετήσεις',        color: '#1565C0', letter: 'Π', url: 'https://vaicon-installations.netlify.app' },
    { key: 'emp',  label: 'Εμπορική Διαχείριση', color: '#ef6c00', letter: '€', url: 'https://vaicon-emporiki.netlify.app' }
  ];

  var html = '';
  for (var i = 0; i < PROGRAMS.length; i++) {
    var p = PROGRAMS[i];
    html += '<div class="tile" onclick="openApp(\'' + p.key + '\')"><div class="badge" style="background:' + p.color + '">' + p.letter + '</div><div class="label">' + p.label + '</div></div>';
  }
  document.getElementById('tiles').innerHTML = html;

  var SCALE = 0.72;
  var innerW = Math.max(PROGRAMS.length, 1) * 236;
  document.getElementById('inner').style.width = innerW + 'px';
  var baseW = innerW + 120, baseH = 592;
  var sw = document.getElementById('scaleWrap');
  if (sw) { sw.style.width = baseW + 'px'; sw.style.height = baseH + 'px'; sw.style.transform = 'scale(' + SCALE + ')'; }
  var W = Math.round(baseW * SCALE), H = Math.round(baseH * SCALE);
  window.resizeTo(W, H);
  try { window.moveTo((screen.availWidth - W) / 2, (screen.availHeight - H) / 2); } catch (e) {}
  var _rz = false;
  function _lock() { if (_rz) return; _rz = true; try { window.resizeTo(W, H); } catch (e) {} setTimeout(function () { _rz = false; }, 40); }
  window.onresize = _lock;
  var _baseIW = 0, _baseIH = 0;
  setTimeout(function () { _baseIW = document.documentElement.offsetWidth; _baseIH = document.documentElement.offsetHeight; }, 250);
  setInterval(function () {
    try {
      var iw = document.documentElement.offsetWidth, ih = document.documentElement.offsetHeight;
      if (_baseIW && iw > 50 && (Math.abs(iw - _baseIW) > 3 || Math.abs(ih - _baseIH) > 3)) _lock();
    } catch (e) {}
  }, 200);

  try { document.getElementById('ver').innerHTML = 'v' + LAUNCHER_VERSION; } catch (e) {}

  var DAYS = ['Κυριακή','Δευτέρα','Τρίτη','Τετάρτη','Πέμπτη','Παρασκευή','Σάββατο'];
  var MONTHS = ['Ιανουαρίου','Φεβρουαρίου','Μαρτίου','Απριλίου','Μαΐου','Ιουνίου','Ιουλίου','Αυγούστου','Σεπτεμβρίου','Οκτωβρίου','Νοεμβρίου','Δεκεμβρίου'];
  function pad(n) { return (n < 10 ? '0' : '') + n; }
  function tick() {
    var d = new Date();
    document.getElementById('time').innerHTML = pad(d.getHours()) + ':' + pad(d.getMinutes());
    document.getElementById('date').innerHTML = DAYS[d.getDay()] + ' ' + d.getDate() + ' ' + MONTHS[d.getMonth()] + ' ' + d.getFullYear() + ' · ' + d.getDate() + '/' + (d.getMonth() + 1) + '/' + d.getFullYear();
  }
  tick();
  setInterval(tick, 1000);

  (function () {
    var orbit = document.getElementById('orbit');
    if (!orbit) return;
    var N = 18, step = 3.4;
    for (var i = 0; i < N; i++) {
      var seg = document.createElement('div');
      seg.style.position = 'absolute'; seg.style.left = '0'; seg.style.top = '0'; seg.style.width = '100%'; seg.style.height = '100%';
      seg.style.transform = 'rotate(' + (-i * step) + 'deg)';
      var t = 1 - i / N;
      var sz = 4 + t * 8;
      var dot = document.createElement('div');
      dot.style.position = 'absolute'; dot.style.left = '50%'; dot.style.top = '0';
      dot.style.width = sz + 'px'; dot.style.height = sz + 'px';
      dot.style.marginLeft = (-sz / 2) + 'px'; dot.style.marginTop = (-sz / 2) + 'px';
      dot.style.borderRadius = '50%'; dot.style.background = '#ffffff';
      dot.style.opacity = String(Math.max(0.05, t));
      if (i === 0) dot.style.boxShadow = '0 0 14px 5px rgba(255,255,255,0.95), 0 0 34px 12px rgba(255,140,90,0.5)';
      seg.appendChild(dot);
      orbit.appendChild(seg);
    }
  })();

  function appBrowser() {
    var drive = sh.ExpandEnvironmentStrings('%SystemDrive%');
    var lad   = sh.ExpandEnvironmentStrings('%LocalAppData%');
    var c = [
      drive + '\\Program Files\\Google\\Chrome\\Application\\chrome.exe',
      drive + '\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe',
      lad   + '\\Google\\Chrome\\Application\\chrome.exe',
      drive + '\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe',
      drive + '\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe'
    ];
    for (var i = 0; i < c.length; i++) {
      try { if (fso.FileExists(c[i])) return c[i]; } catch (e) {}
    }
    return null;
  }

  function openApp(key) {
    var url = null;
    for (var i = 0; i < PROGRAMS.length; i++) { if (PROGRAMS[i].key === key) { url = PROGRAMS[i].url; break; } }
    if (!url) return;
    var cp = appBrowser();
    if (cp) { sh.Run('"' + cp + '" --app=' + url, 1, false); }
    else { sh.Run(url, 1, false); }
  }
</script>
</body>
</html>
